# Copy this file to .env and fill in what you need. Never commit .env.

# Live mode (Claude). Leave the key empty to run in demo mode only.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# ANTHROPIC_EFFORT=low        # low | medium | high; set empty for models without effort support
# ANTHROPIC_MAX_TOKENS=4000

# Optional second opinion from TypeSafe's Jev (live mode only).
TYPESAFE_API_KEY=
# TYPESAFE_MODEL=jev-latest

# Optional Langfuse tracing (live mode only). Sends prompts and outputs to Langfuse.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_BASE_URL=https://cloud.langfuse.com   # or https://us.cloud.langfuse.com, or your self-hosted URL
